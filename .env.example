# Copy to .env and paste your key after the = sign. .env is git-ignored and never reaches the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: origins allowed to call /api/chat from another site (comma-separated, *. wildcards).
# Defaults to any https://*.github.io site and localhost.
# CHAT_ALLOWED_ORIGINS=https://your-name.github.io

# Optional, at build time: where a statically hosted build (GitHub Pages) sends chat requests.
# VITE_CHAT_API_URL=https://your-project.vercel.app/api/chat
